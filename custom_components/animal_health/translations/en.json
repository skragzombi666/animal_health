        "unit": {
          "name": "Unit",
          "description": "Unit for the numeric measurement, for example kg or °C."
        },
        "correction_of_event_id": {
          "name": "Correction of event ID",
          "description": "Optional event ID corrected by this new entry. The original event remains unchanged."
        }
