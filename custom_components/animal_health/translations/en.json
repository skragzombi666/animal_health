      "fields": {
        "device_id": {
          "name": "Animal",
          "description": "Select the animal by name."
        },
        "event_type": {
          "name": "Event type",
          "description": "Category of the event."
        },
        "occurred_at": {
          "name": "Occurred at",
          "description": "Date and time of the event. Current time is used when omitted."
